<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Hika.Domain\Hika.Domain.csproj" />
    <ProjectReference Include="..\Hika.Application\Hika.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- So Hika.UnitTests can exercise OzowHashHelper directly — a pure, deterministic
         function worth testing on its own, without making it part of any public API — and so
         Hika.IntegrationTests can use the same helper to sign webhook payloads in its Ozow
         tests instead of a second, potentially-drifting reimplementation of the algorithm. -->
    <InternalsVisibleTo Include="Hika.UnitTests" />
    <InternalsVisibleTo Include="Hika.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
