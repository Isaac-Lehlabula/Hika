{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "hika-api",
    "Audience": "hika-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Smtp": {
    "Host": "",
    "Port": 1025,
    "From": "no-reply@hika.local"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  }
}
