{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "hika-api",
    "Audience": "hika-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Smtp": {
    "Host": "",
    "Port": 1025,
    "From": "no-reply@hikingspot.local"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "LocalFileStorage": {
    "RootPath": "uploads",
    "PublicBaseUrl": "http://localhost:5080"
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "ReportsPermitLimit": 20,
    "ReportsWindowSeconds": 60
  },
  "Ozow": {
    "SiteCode": "",
    "PrivateKey": "",
    "ApiKey": "",
    "IsTest": true,
    "ApiBaseUrl": "https://stagingapi.ozow.com"
  }
}
