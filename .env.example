# Copy this file to .env and fill in real values for local development.
# .env is git-ignored — never commit real secrets.

# ---- PostgreSQL ----
POSTGRES_DB=hika
POSTGRES_USER=hika
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5436

# Full connection string the API uses (Npgsql format)
ConnectionStrings__Default=Host=postgres;Port=5432;Database=hika;Username=hika;Password=change-me-locally

# ---- JWT ----
# Generate a strong random value for local dev, e.g.: openssl rand -base64 64
Jwt__SigningKey=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
Jwt__Issuer=hika-api
Jwt__Audience=hika-client
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# ---- Mail (Mailhog for local dev) ----
Smtp__Host=mailhog
Smtp__Port=1025
Smtp__From=no-reply@hika.local

# ---- Links embedded in verification/reset emails ----
# Placeholder until the mobile app's Universal Link / custom-scheme domain is set up (see
# docs/mobile-architecture.md); for now the Verify Email / Reset Password screens also accept
# the token pasted in manually as a fallback, so this doesn't block local development.
Frontend__BaseUrl=http://localhost:3000

# ---- Ports ----
API_PORT=5080
MAILHOG_UI_PORT=8025
