# Copy this file to .env and fill in real values for local development.
# .env is git-ignored — never commit real secrets.

# ---- PostgreSQL ----
POSTGRES_DB=hika
POSTGRES_USER=hika
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Full connection string the API uses (Npgsql format)
ConnectionStrings__Default=Host=postgres;Port=5432;Database=hika;Username=hika;Password=change-me-locally

# ---- JWT ----
# Generate a strong random value for local dev, e.g.: openssl rand -base64 64
Jwt__SigningKey=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
Jwt__Issuer=hika-api
Jwt__Audience=hika-client
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# ---- Mail (Mailhog for local dev) ----
Smtp__Host=mailhog
Smtp__Port=1025
Smtp__From=no-reply@hika.local

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
API_INTERNAL_BASE_URL=http://api:8080

# ---- Ports ----
API_PORT=5080
WEB_PORT=3000
MAILHOG_UI_PORT=8025
